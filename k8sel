#!/usr/bin/env bash
die() {
    echo "$@" >&2
    exit 1
}

for cmd in "fzf" "yq"; do
  command -v "$cmd" >/dev/null || die "Required command $cmd not found."
done

yq_filter() {
  # transform args of kind/name@namespace to yq select
  filter=$(yq -r '
  split(" ") | map(
    match("(.*)/(.*)@(.*)").captures | map(.string)
     | "(.kind==\"\(.[0])\" " +
        "and .metadata.name==\"\(.[1])\" " +
        "and (.metadata.namespace // \"default\")==\"\(.[2])\" )"
    ) | join " or "'  <<< "$@")
  printf "select( %s )" "$filter"
}


get_resources() {
  # generate the filter and apply to the input yaml
  filter=$(yq_filter "$@")
  yq e "$filter" "$input_yaml"
}

export -f yq_filter
export -f get_resources

run() {
  # extract kind/name@namespace from input, run fzf, branch on exit code
  local selection rc=0
  selection=$(yq '.metadata.namespace=.metadata.namespace // "default" | "\(.kind)/\(.metadata.name)@\(.metadata.namespace)"' "$input_yaml" \
    | fzf --no-reverse -m \
        --bind "alt-enter:become(echo {+} ; exit 10)" \
        --bind "ctrl-f:execute(get_resources {+} | yq -C | less -R)" \
        --preview 'bash -c "get_resources {} | yq -C"') || rc=$?

  case $rc in
    0)
      [ -z "$selection" ] && return 0
      echo "$selection" | xargs bash -c 'get_resources "$0" "$@"'
      ;;
    10)
      # alt-enter: print just the kind/name@ns identifiers, exit 10 so
      # a wrapper (e.g. the k8sel oh-my-zsh plugin) can inject a re-runnable
      # command onto the shell prompt via `print -z`
      echo "$selection"
      return 10
      ;;
    *)
      return $rc
      ;;
  esac
}

if [ "$0" == $BASH_SOURCE ]; then
  resources=""
  resource_parsing=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help)
        echo "Usage: k8sel [input.yaml] [-r kind/name@ns ...]"
        echo '
Interactively filter k8s resources from multi document yaml using fzf

i.e.
*  k8sel input.yaml
*  helm template | k8sel  | kubectl apply -f -
*  k8sel input.yaml -r Deployment/foo@default Service/bar@default

Options:
  -r: filter resource by kind/name@namespace - multiple allowed.
      If supplied, outputs matching resources directly (no interactive selection).

FZF hints:
  Search syntax: https://github.com/junegunn/fzf?tab=readme-ov-file#search-syntax
  TAB/ SHIFT-TAB:      select/deselect resource for inclusion in final output
  ARROW UP/DOWN:       navigate resources list
  ENTER:               output selected resources as yaml
  ALT-ENTER:           output just kind/name@ns identifiers (exit code 10;
                       used by the k8sel zsh plugin to put a re-runnable
                       command onto the next prompt)
  CTRL-F:              open selected resources in less
  ESC/CTRL-C:          exit without output
  SHIFT-ARROW UP/DOWN: scroll preview window
'
        exit 0
        ;;
      -r)
        resource_parsing=true
        ;;
      *)
        if [ "$resource_parsing" = true ]; then
          resources+="$1 "
        else
          [ -z "$input_yaml" ] || die "Only one input file allowed"
          if [ -n "$1" ]; then
            [ -f "$1" ] || die "Input file $1 not found"
            input_yaml=$1
          fi
        fi
        ;;
    esac
    shift
  done

  if [ -z "$input_yaml" ]; then
    input_yaml=$(mktemp)
    cat > "$input_yaml"
  fi

  # check that the input is parsable k8s yaml
  [ "$(yq ea '[ .kind] | length ' "$input_yaml" )" -eq 0 ] && die "Input doesn't seem to be valid k8s yaml"

  # auto-unwrap kind:List — the k8s API wraps multi-resource responses in a
  # List object with resources in .items[]. Detect this and explode to
  # individual documents so k8sel can work with each resource directly.
  if [ "$(yq e '.kind' "$input_yaml")" = "List" ]; then
    unwrapped=$(mktemp)
    yq e '.items[] | split_doc' "$input_yaml" > "$unwrapped"
    if [ "$(yq ea '[ .kind] | length ' "$unwrapped" )" -eq 0 ]; then
      die "List.items[] contains no valid k8s resources"
    fi
    input_yaml="$unwrapped"
  fi

  export input_yaml

  if [ -n "$resources" ]; then
    # non-interactive: filter and output matching resources directly
    get_resources $resources
  else
    run
  fi
fi
